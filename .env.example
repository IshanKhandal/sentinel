# ==============================================================================
# SENTINEL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# PROTOCOL STANDARD: Rule 41 (NEVER commit secrets or production credentials)
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.
# ==============================================================================

# Database Configuration
# Local Development (Default): SQLite
DATABASE_URL=sqlite:///./sentinel.db

# Production Target (PostgreSQL):
# NOTE: PostgreSQL CLI is not installed locally; do not activate until PostgreSQL server is verified.
# DATABASE_URL=postgresql+psycopg2://sentinel_user:change_me_in_production@localhost:5432/sentinel_db

# Operational Mode: DEMO or LIVE (Rule 29 / docs/demo-mode.md)
# DEMO: Uses synthetic fixtures and explicitly badged mock playback.
# LIVE: Requires real, verified surveillance streams. Missing connections display UNAVAILABLE/OFFLINE.
SENTINEL_OPERATION_MODE=DEMO

# Security & Tokens (Development placeholder ONLY - minimum 32 characters)
SECRET_KEY=development-only-insecure-secret-key-do-not-use-in-production-min32c
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
